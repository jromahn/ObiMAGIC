Bootstrap: docker
From: ubuntu:24.04

%help
        ObiMAGIC - Metabarcoding Analysis Guidance Integration Control Pipeline for ObiTools4
        All ObiMAGIC scripts and dependencies can be called directly, e.g.:
        apptainer exec 00_ObiMAGIC_main.pl

%post
	apt-get -y update
	apt-get -y install --no-install-recommends perl libjson-perl libgd-perl build-essential curl libcurl4-gnutls-dev zlib1g-dev libssl-dev python3-dev python3-pip python3-venv wget pigz git gfortran libbz2-dev liblzma-dev libpcre2-dev libblas-dev liblapack-dev cmake dos2unix libxml2-dev libpng-dev libjpeg-turbo8-dev libfontconfig1-dev libharfbuzz-dev libfribidi-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev libwebp-dev

	#perl modules
	cpan App::cpanminus
	cpanm Cwd File::Basename IO::Zlib IPC::Cmd List::MoreUtils File::Find Encode Text::Iconv Spreadsheet::XLSX
	
	#R 4.5.1
	apt-get -y install --no-install-recommends software-properties-common dirmngr
	wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | tee -a /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
	add-apt-repository "deb https://cloud.r-project.org/bin/linux/ubuntu $(lsb_release -cs)-cran40/"
	apt-get -y install --no-install-recommends r-base

	#R libraries
	R -e "install.packages(c('cowplot','dplyr','gapminder','ggplot2','ggpmisc','ggpubr','ghibli','magrittr','plotly','seqinr','taxize','taxonomizr','tidyverse','treemapify','vegan'),repos='http://cran.us.r-project.org')"

	#cutadapt
	python3 -m venv cutadapt-5.1
	cutadapt-5.1/bin/pip3 install --upgrade pip
	cutadapt-5.1/bin/pip3 install cutadapt==5.1
	
	#ObiTools
	curl -L https://raw.githubusercontent.com/metabarcoding/obitools4/master/install_obitools.sh | bash -s -- --install-dir ObiTools4/ --obitools-prefix obi4_
	
	#new_taxdump
	mkdir new_taxdump_$(date +%Y-%m-%d)
	cd new_taxdump_$(date +%Y-%m-%d)
	wget https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump.tar.gz
	tar xf taxdump.tar.gz
	rm taxdump.tar.gz
	cd ..
	ln -s new_taxdump_$(date +%Y-%m-%d) new_taxdump
	
	#ObiMAGIC
	git clone https://github.com/jromahn/ObiMAGIC.git
	cd ObiMAGIC
	git checkout v0.3

%environment
    export LC_ALL=C
    export PATH=/ObiMAGIC:/ObiMAGIC/00_ObiScripts:/ObiMAGIC/00_ObiExtra:/ObiTools4/bin:/cutadapt-5.1/bin:$PATH

